<map proto="1.4.2">
<name>Traffic Jam 2</name>
<version>1.1.1</version>
<objective>Capture the enemy team's wool.</objective>
<time result="objectives" max-overtime="10m" overtime="10m">25m</time>
<authors>
    <author uuid="70c5c702-4e70-457b-8d7b-0e22010dc590"/> <!-- ocal -->
</authors>
<teams>
    <team id="blue-team" color="blue" max="5" max-overfill="5">Blue</team>
    <team id="red-team" color="dark red" max="5" max-overfill="5">Red</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="iron sword"/>
        <item slot="1" unbreakable="true" material="bow"/>
        <item slot="28" amount="40" material="arrow"/>
        <item slot="2" unbreakable="true" material="iron pickaxe">
            <enchantment>efficiency</enchantment>
        </item>
        <item slot="3" unbreakable="true" material="iron axe">
            <enchantment>efficiency</enchantment>
        </item>
        <item slot="4" material="water bucket"/>
        <item slot="5" material="golden apple"/>
        <item slot="6" unbreakable="true" material="iron spade"/>
        <item slot="7" amount="64" material="glass"/>
        <item slot="8" amount="64" material="wood" damage="5"/>
        <item slot="35" amount="64" material="wood" damage="5"/>
        <item slot="9" amount="8" material="wood button"/>
        <item slot="10" amount="8" material="wood plate"/>
        <item slot="11" amount="3" material="wood door"/>
        <effect duration="5">heal</effect>
    </kit>
    <kit id="blue-kit" parents="spawn-kit">
        <helmet unbreakable="true" color="334CB2" material="leather helmet"/>
        <chestplate unbreakable="true" color="334CB2" material="leather chestplate">
            <enchantment>projectile_protection</enchantment>
        </chestplate>
    </kit>
    <kit id="red-kit" parents="spawn-kit">
        <helmet unbreakable="true" color="993333" material="leather helmet"/>
        <chestplate unbreakable="true" color="993333" material="leather chestplate">
            <enchantment>projectile_protection</enchantment>
        </chestplate>
    </kit>
</kits>
<spawns>
    <default>
        <region yaw="90">
            <point>5.5,43.5,61.5</point>
        </region>
    </default>
    <spawn team="blue-team" kit="blue-kit">
        <region yaw="-90">
            <point>-124.5,8,117.5</point>
        </region>
    </spawn>
    <spawn team="red-team" kit="red-kit">
        <region yaw="-90">
            <point>-124.5,8,5.5</point>
        </region>
    </spawn>
</spawns>
<filters>
    <not id="blue-in-wr">
        <any>
            <team id="only-red">red-team</team>
            <material>chest</material>
        </any>
    </not>
    <not id="red-in-wr">
        <any>
            <team id="only-blue">blue-team</team>
            <material>chest</material>
        </any>
    </not>
    <all id="only-iron-regen">
        <material id="only-iron">iron block</material>
        <cause>world</cause>
    </all>
    <not id="deny-void">
        <void/>
    </not>
</filters>
<regions>
    <union id="spawns">
        <cuboid id="blue-spawn" min="-134,0,100" max="-102,25,136"/>
        <cuboid id="red-spawn" min="-134,0,-13" max="-102,25,24"/>
    </union>
    <union id="wool-rooms">
        <rectangle id="purple-for-blue" min="-39,-41" max="-26,-27"/>
        <rectangle id="orange-for-red" min="-39,150" max="-26,164"/>
    </union>
    <complement id="not-map">
        <everywhere/>
        <rectangle min="-102,-2" max="-26,125"/>
    </complement>
    <union id="spawner-regions">
        <point id="spawner-spawn">-27.5,7,61.5</point>
        <cylinder id="spawner-player" base="-27.5,7,61.5" radius="5" height="5"/>
        <cylinder id="spawner-region" base="-27.5,6,61.5" radius="2" height="4"/>
    </union>
    <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy team's spawn!"/>
    <apply enter="only-red" region="red-spawn" message="You may not enter the enemy team's spawn!"/>
    <apply enter="only-blue" region="purple-for-blue" message="You may not modify or enter your own wool room!"/>
    <apply enter="only-red" region="orange-for-red" message="You may not modify or enter your own wool room!"/>
    <apply block="never" region="spawner-region" message="You may not modify the spawner!"/>
    <apply block-break="only-iron" block-place="only-iron-regen" region="spawns" message="You may only break iron blocks at spawn!"/>
    <apply use="only-blue" block="blue-in-wr" region="purple-for-blue"/>
    <apply use="only-red" block="red-in-wr" region="orange-for-red"/>
    <apply block="deny-void" region="not-map" message="You may not build in the void!"/>
</regions>
<wools craftable="false" wool-proximity-metric="none" monument-proximity-metric="closest block">
    <wool team="blue-team" color="purple" location="-32.5,11.5,-33.5">
        <monument>
            <block>-110,8,117</block>
        </monument>
    </wool>
    <wool team="red-team" color="orange" location="-32.5,11.5,156.5">
        <monument>
            <block>-110,8,5</block>
        </monument>
    </wool>
</wools>
<block-drops>
    <!-- Common blocks -->
    <rule>
        <filter>
            <any>
                <material damage="8">double step</material>
                <material>stained clay</material>
                <material>mossy cobblestone</material>
                <material>quartz block</material>
                <material>smooth brick</material>
                <material>hopper</material>
                <material>furnace</material>
                <material>dispenser</material>
                <material>cauldron</material>
                <material>coal block</material>
            </any>
        </filter>
        <drops>
            <item material="cobblestone"/>
        </drops>
    </rule>
    <!-- Stairs -->
    <rule>
        <filter>
            <any>
                <material>smooth stairs</material>
                <material>quartz stairs</material>
            </any>
        </filter>
        <drops>
            <item material="cobblestone stairs"/>
        </drops>
    </rule>
    <!-- Slabs -->
    <rule>
        <filter>
            <any>
                <material damage="0">step</material>
                <material damage="5">step</material>
                <material damage="7">step</material>
                <material>daylight detector</material>
                <material>daylight detector inverted</material>
            </any>
        </filter>
        <drops>
            <item damage="3" material="step"/>
        </drops>
    </rule>
    <!-- Wool -->
    <rule>
        <filter>
            <any>
                <material>wool:14</material>
                <material>wool:7</material>
                <material>wool:11</material>
            </any>
        </filter>
        <drops>
            <item damage="15" material="wool"/>
        </drops>
    </rule>
    <!-- Cobble Walls -->
    <rule>
        <filter>
            <any>
                <material>nether fence</material>
            </any>
        </filter>
        <drops>
            <item damage="0" material="cobble wall"/>
        </drops>
    </rule>
    <!-- Leaves -->
    <rule>
        <filter>
            <material>leaves</material>
        </filter>
        <drops>
            <item chance="0">nether star</item>
        </drops>
    </rule>
</block-drops>
<itemremove> <!-- Items addded to this section are deleted if they are dropped in any way onto the floor (add stone slabs to this)-->
    <item>leather chestplate</item>
    <item>chainmail leggings</item>
    <item>leather boots</item>
    <item>string</item>
    <item>apple</item>
    <item>sugar cane</item>
    <item>clay ball</item>
    <item>stone plate</item>
    <item>iron plate</item>
    <item>sand</item>
    <item>redstone</item>
    <item>redstone torch off</item>
    <item>redstone torch on</item>
    <item>skull</item>
    <item>carpet</item>
    <item>wood stairs</item>
    <item>spruce wood stairs</item>
    <item>birch wood stairs</item>
    <item>jungle wood stairs</item>
    <item>acacia stairs</item>
    <item>dark oak stairs</item>
    <item>wood step</item>
    <item>stone button</item>
    <item>sign</item>
    <item>lever</item>
    <item>redstone comparator</item>
    <item>ladder</item>
    <item>iron door</item>
    <item>trap door</item>
    <item>fence</item>
</itemremove>
<itemkeep> <!-- Items added to this section are removed upon death, but can still be manually dropped -->
    <item>wood door</item>
    <item>wood button</item>
    <item>wood plate</item>
    <item>wood</item>
    <item>log</item>
    <item>glass</item>
    <item>arrow</item>
    <item>iron sword</item>
    <item>iron pickaxe</item>
    <item>iron spade</item>
    <item>iron axe</item>
    <item>water bucket</item>
    <item>bow</item>
</itemkeep>
<block-drops> <!-- This prevents planks from dropping when mined and ensures flint drops -->
    <rule wrong-tool="true">
        <region>
            <rectangle min="-oo,-oo" max="oo,oo"/>
        </region>
        <filter>
            <any>
                <material>gravel</material>
            </any>
        </filter>
        <drops>
            <item material="flint"/>
        </drops>
    </rule>
    <rule>
        <region>
            <rectangle min="-oo,-oo" max="oo,oo"/>
        </region>
        <filter>
            <all>
                <material>wood</material>
                <cause>mine</cause>
            </all>
        </filter>
        <drops>
            <item chance="0" material="wood"/>
        </drops>
    </rule>
</block-drops>
<renewables>
    <renewable renew-filter="only-iron" region="spawns" sound="true" particles="true"/>
</renewables>
<spawners>
    <spawner spawn-region="spawner-spawn" player-region="spawner-player" delay="12s">
        <item material="golden apple"/>
    </spawner>
</spawners>
<toolrepair>
    <tool>iron sword</tool>
    <tool>bow</tool>
    <tool>iron pickaxe</tool>
    <tool>iron axe</tool>
</toolrepair>
<itemremove>
    <item>glass</item>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>golden carrot</item>
    <item>redstone</item>
    <item>redstone torch on</item>
    <item>apple</item>
    <item>seeds</item>
    <item>sapling</item>
    <item>31</item>
    <item>37</item>
    <item>38</item>
    <item>175</item>
    <item>338</item>
    <item>66</item>
</itemremove>
<kill-reward>
    <item amount="32" material="wood"/>
    <item amount="16" material="glass"/>
    <item material="golden apple"/>
    <item amount="10" material="arrow"/>
</kill-reward>
<crafting>
    <disable>iron trapdoor</disable>
    <disable>minecart</disable>
    <disable>boat</disable>
</crafting>
<maxbuildheight>20</maxbuildheight>
<hunger>
    <depletion>off</depletion>
</hunger>
<respawn delay="5s" auto="true" blackout ="true"/>
<item-mods>
    <rule>
        <match>
            <material>iron chestplate</material>
        </match>
        <modify>
            <enchantment>projectile_protection</enchantment>
        </modify>
    </rule>
</item-mods>
</map>
