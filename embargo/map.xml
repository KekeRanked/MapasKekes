<map proto="1.5.0">
<name>Embargo</name>
<version>1.1.2</version>
<variant id="5v5">5v5</variant>
<unless variant="5v5">
    <!-- Base KotF kit include file -->
    <!-- Created by mameBT -->
    <!-- Version 2025.06.16-1 -->
    <!-- Base conquest kit include file -->
    <!-- Created by mameBT -->
    <!-- Version 2026.02.04-1 -->
    <!-- Golden apple kill reward include file -->
    <!-- Author: Pablete1234 -->
    <!-- Version 2026.03.03 -->
    <!--
        This include file prevents golden apple consumption from being interrupted
        after killing another play and receiving a golden apple as a kill reward.
    -->
    <constants fallback="true">
        <constant id="gapple-name" delete="true"/>
        <constant id="gapple-lore" delete="true"/>
        <constant id="gapple-slot" delete="true"/>
        <constant id="gapple-locked" delete="true"/>
        <constant id="gapple-reward-filter" delete="true"/>
    </constants>
    <variables>
        <variable id="missing_gaps" scope="player"/>
    </variables>
    <filters>
        <holding id="holding-gap" ignore-metadata="true">
            <item>golden apple</item>
        </holding>
        <pulse id="pulse-give-gap" duration="0.05s" period="0.1s" filter="all(not(holding-gap),missing_gaps=1..)"/>
    </filters>
    <actions>
        <action id="give-gap" scope="player">
            <kit deduct-items="false">
                <item material="golden apple" slot="${gapple-slot}" locked="${gapple-locked}" name="${gapple-name}" lore="${gapple-lore}"/>
            </kit>
            <set var="missing_gaps" value="missing_gaps-1"/>
        </action>
        <trigger scope="player" filter="pulse-give-gap" action="give-gap"/>
    </actions>
    <kill-rewards>
        <kill-reward filter="${gapple-reward-filter}">
            <action>
                <set var="missing_gaps" value="missing_gaps+1"/>
                <action filter="not(holding-gap)">
                    <action id="give-gap"/>
                </action>
            </action>
        </kill-reward>
    </kill-rewards>
    <constants fallback="true">
        <constant id="override-itemkeep">false</constant>
        <constant id="override-kill-reward">false</constant>
    </constants>
    <kits>
        <kit id="base-kit">
            <clear/>
            <item slot="0" unbreakable="true" material="stone sword"/>
            <item slot="1" unbreakable="true" material="bow"/>
            <item slot="2" material="golden apple"/>
            <item slot="8" amount="12" material="arrow"/>
            <helmet unbreakable="true" team-color="true" material="leather helmet"/>
            <chestplate unbreakable="true" team-color="true" material="leather chestplate"/>
            <leggings unbreakable="true" material="chainmail leggings">
                <enchantment level="3">projectile_protection</enchantment>
            </leggings>
            <boots unbreakable="true" material="iron boots"/>
            <effect duration="${damage-resistance}" amplifier="5">resistance</effect>
            <game-mode>adventure</game-mode>
        </kit>
    </kits>
    <toolrepair>
        <tool>stone sword</tool>
        <tool>bow</tool>
    </toolrepair>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>iron boots</item>
        <item>banner</item>
    </itemremove>
    <unless constant="override-itemkeep" constant-value="true">
        <itemkeep>
            <item>stone sword</item>
            <item>bow</item>
            <item>golden apple</item>
            <item>arrow</item>
        </itemkeep>
    </unless>
    <unless constant="override-kill-reward" constant-value="true">
        <kill-rewards>
            <kill-reward>
                <item amount="6" material="arrow"/>
            </kill-reward>
        </kill-rewards>
    </unless>
    <respawn delay="${respawn-timer}" auto="true"/>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <constants fallback="true">
        <constant id="respawn-timer">2s</constant>
        <constant id="score">200</constant>
        <constant id="flag-respawn-timer">18s</constant>
        <constant id="announce-post-pickup">false</constant>
    </constants>
    <gamemode>kotf</gamemode>
    <kits>
        <kit id="base-kit-compass" parent="base-kit">
            <item slot="3" material="compass"/>
        </kit>
        <kit id="flag-kit-no-slowness" force="true">
            <action>
                <enchant-item ignore-metadata="true" enchantment="projectile_protection" level="2">
                    <find material="chainmail leggings"/>
                </enchant-item>
            </action>
            <max-health>8</max-health>
            <if min-server-version="1.9">
                <effect>glowing</effect>
            </if>
            <effect duration="3s" amplifier="2">absorption</effect>
        </kit>
        <kit id="flag-kit" force="true" parent="flag-kit-no-slowness">
            <effect>slowness</effect>
        </kit>
        <kit id="reset-health" force="true">
            <action>
                <enchant-item ignore-metadata="true" enchantment="projectile_protection" level="3">
                    <find material="chainmail leggings"/>
                </enchant-item>
            </action>
            <max-health>20</max-health>
            <if min-server-version="1.9">
                <effect duration="0s" amplifier="0">glowing</effect>
            </if>
            <effect duration="0s" amplifier="0">slowness</effect>
            <effect duration="2s" amplifier="10">regeneration</effect>
            <action>
                <switch-scope inner="match">
                    <switch-scope inner="player" filter="all(alive,not(flag-carrier))">
                        <kit>
                            <effect duration="4s" amplifier="3">regeneration</effect>
                        </kit>
                    </switch-scope>
                </switch-scope>
            </action>
        </kit>
    </kits>
    <filters>
        <any id="has-flag">
            <carrying-flag id="flag-carrier">flag</carrying-flag>
            <not>
                <same-team>
                    <filter id="flag-carrier"/>
                </same-team>
            </not>
        </any>
        <deny id="deny-flag-carrier">
            <filter id="flag-carrier"/>
        </deny>
    </filters>
    <compass show-distance="true">
        <player filter="flag-carrier" show-player="true" name="Flag Carrier"/>
    </compass>
    <score>
        <limit>${score}</limit>
    </score>
    <toolrepair>
        <tool>compass</tool>
    </toolrepair>
    <itemkeep>
        <item>compass</item>
    </itemkeep>
    <respawn spectate="true">
        <message>
            {"translate":"death.respawn.confirmed.waiting.flagDropped"}
        </message>
    </respawn>
    <constant id="max">12</constant>
    <constant id="max-overfill" delete="true"/>
</unless>
<if variant="5v5">
    <!-- Base competitive KotF kit include file -->
    <!-- Created by mameBT -->
    <!-- Version 2025.05.13-1 -->
    <!-- Base conquest (competitive) kit include file -->
    <!-- Created by mameBT -->
    <!-- Version 2026.02.04-1 -->
    <!-- Golden apple kill reward include file -->
    <!-- Author: Pablete1234 -->
    <!-- Version 2026.03.03 -->
    <!--
        This include file prevents golden apple consumption from being interrupted
        after killing another play and receiving a golden apple as a kill reward.
    -->
    <constants fallback="true">
        <constant id="gapple-name" delete="true"/>
        <constant id="gapple-lore" delete="true"/>
        <constant id="gapple-slot" delete="true"/>
        <constant id="gapple-locked" delete="true"/>
        <constant id="gapple-reward-filter" delete="true"/>
    </constants>
    <variables>
        <variable id="missing_gaps" scope="player"/>
    </variables>
    <filters>
        <holding id="holding-gap" ignore-metadata="true">
            <item>golden apple</item>
        </holding>
        <pulse id="pulse-give-gap" duration="0.05s" period="0.1s" filter="all(not(holding-gap),missing_gaps=1..)"/>
    </filters>
    <actions>
        <action id="give-gap" scope="player">
            <kit deduct-items="false">
                <item material="golden apple" slot="${gapple-slot}" locked="${gapple-locked}" name="${gapple-name}" lore="${gapple-lore}"/>
            </kit>
            <set var="missing_gaps" value="missing_gaps-1"/>
        </action>
        <trigger scope="player" filter="pulse-give-gap" action="give-gap"/>
    </actions>
    <kill-rewards>
        <kill-reward filter="${gapple-reward-filter}">
            <action>
                <set var="missing_gaps" value="missing_gaps+1"/>
                <action filter="not(holding-gap)">
                    <action id="give-gap"/>
                </action>
            </action>
        </kill-reward>
    </kill-rewards>
    <constants fallback="true">
        <constant id="override-itemkeep">false</constant>
        <constant id="override-kill-reward">false</constant>
    </constants>
    <phase>staging</phase> <!-- prevent competitive conquest from sponsoring -->
    <kits>
        <kit id="base-kit">
            <clear/>
            <item slot="0" unbreakable="true" material="stone sword"/>
            <item slot="1" unbreakable="true" material="bow"/>
            <item slot="2" material="golden apple"/>
            <item slot="8" amount="8" material="arrow"/>
            <helmet unbreakable="true" team-color="true" material="leather helmet"/>
            <chestplate unbreakable="true" team-color="true" material="leather chestplate"/>
            <leggings unbreakable="true" material="chainmail leggings">
                <enchantment level="3">projectile_protection</enchantment>
            </leggings>
            <boots unbreakable="true" material="iron boots">
                <enchantment>feather_falling</enchantment>
                <enchantment>fire_protection</enchantment>
            </boots>
            <effect duration="${damage-resistance}" amplifier="5">resistance</effect>
            <game-mode>adventure</game-mode>
        </kit>
    </kits>
    <toolrepair>
        <tool>stone sword</tool>
        <tool>bow</tool>
    </toolrepair>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>iron boots</item>
        <item>banner</item>
    </itemremove>
    <unless constant="override-itemkeep" constant-value="true">
        <itemkeep>
            <item>stone sword</item>
            <item>bow</item>
            <item>golden apple</item>
            <item>arrow</item>
        </itemkeep>
    </unless>
    <unless constant="override-kill-reward" constant-value="true">
        <kill-rewards>
            <kill-reward>
                <item amount="4" material="arrow"/>
            </kill-reward>
        </kill-rewards>
    </unless>
    <respawn delay="${respawn-timer}" auto="true"/>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <constants fallback="true">
        <constant id="respawn-timer">2s</constant>
        <constant id="score">200</constant>
        <constant id="flag-respawn-timer">23s</constant>
        <constant id="announce-post-pickup">true</constant>
    </constants>
    <gamemode>kotf</gamemode>
    <kits>
        <kit id="base-kit-compass" parent="base-kit">
            <item slot="3" material="compass"/>
        </kit>
        <kit id="flag-kit" force="true">
            <max-health>8</max-health>
            <if min-server-version="1.9">
                <effect>glowing</effect>
            </if>
            <effect duration="3s" amplifier="2">absorption</effect>
        </kit>
        <kit id="reset-health" force="true">
            <max-health>20</max-health>
            <if min-server-version="1.9">
                <effect duration="0s" amplifier="0">glowing</effect>
            </if>
        </kit>
    </kits>
    <filters>
        <any id="has-flag">
            <carrying-flag id="flag-carrier">flag</carrying-flag>
            <not>
                <same-team>
                    <filter id="flag-carrier"/>
                </same-team>
            </not>
        </any>
        <deny id="deny-flag-carrier">
            <filter id="flag-carrier"/>
        </deny>
    </filters>
    <compass show-distance="true">
        <player filter="flag-carrier" show-player="true" name="Flag Carrier"/>
    </compass>
    <score>
        <limit>${score}</limit>
    </score>
    <toolrepair>
        <tool>compass</tool>
    </toolrepair>
    <itemkeep>
        <item>compass</item>
    </itemkeep>
    <respawn spectate="true">
        <message>
            {"translate":"death.respawn.confirmed.waiting.flagDropped"}
        </message>
    </respawn>
    <constant id="max">5</constant>
    <constant id="max-overfill">5</constant>
    <constant id="respawn-timer">5s</constant>
</if>
<constant id="damage-resistance">4s</constant>
<objective>Capture and hold the flag for ${score} seconds to win</objective>
<!-- Map authors & contributors. -->
<authors>
    <author uuid="b03360db-b8cd-49de-8ba1-b7920c2238a9" contribution="Map author"/> <!-- Obelistics -->
</authors>
<contributors>
    <contributor  uuid="dff980ed-9f69-491e-b79c-30c21350baf2" contribution="Feedback"/> <!-- DoomyBoy -->
    <contributor  uuid="621b2aa8-4e5f-4ed8-bd36-0ae2f8952a06" contribution="Feedback"/> <!-- Strangey -->
</contributors>
<!-- Map modules, i.e. objectives, regions, spawns. -->
<teams>
    <team id="red" color="red" max="${max}" max-overfill="${max-overfill}">Red</team>
    <team id="blue" color="blue" max="${max}" max-overfill="${max-overfill}">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit" parent="base-kit">
        <action>
            <replace-item>
                <find unbreakable="true" material="iron boots"/>
                <replace unbreakable="true" enchantment="feather_falling:2" material="iron boots"/>
            </replace-item>
        </action>
    </kit>
</kits>
<spawns>
    <default>
        <region yaw="-90">
            <block>-31.5,25,1.5</block>
        </region>
    </default>
    <spawn team="red" kit="spawn-kit" filter="has-flag">
        <region yaw="0">
            <point>5,10,-41</point>
        </region>
    </spawn>
    <spawn team="blue" kit="spawn-kit" filter="has-flag">
        <region yaw="180">
            <point>5,10,44</point>
        </region>
    </spawn>
</spawns>
<filters>
    <any id="above-or-below-canyon">
        <not>
            <cuboid min="24,10,-1" max="29,13,4"/>
        </not>
    </any>
    <any id="above-or-below-lava">
        <not>
            <cuboid min="-2,8,-1" max="3,12,4"/>
        </not>
    </any>
</filters>
<regions>
    <cylinder id="gapple-trigger" base="0.5,16,1.5" radius="5" height="2"/>
    <block id="gapple-spawner">0.5,17,1.5</block>
    <apply block="never" use="never"/>
</regions>
<spawners>
    <spawner spawn-region="gapple-spawner" player-region="gapple-trigger" delay="5s" max-entities="2">
        <item amount="1" material="golden apple"/>
    </spawner>
</spawners>
<flags>
    <flag id="flag"
          name="Flag"
          color="purple"
          shared="true"
          points-rate="1"
          pickup-kit="flag-kit"
          drop-kit="reset-health"
          flag-proximity-metric="none"
          show-respawn-on-pickup="${announce-post-pickup}">
        <post return-time="0s" respawn-time="${flag-respawn-timer}">
            <post name="Canyon Post" yaw="90" pickup-filter="above-or-below-canyon">26.5,13,1.5</post>
            <post name="Lava Post" yaw="-90" pickup-filter="above-or-below-lava">0.5,12,1.5</post>
        </post>
    </flag>
</flags>
</map>
