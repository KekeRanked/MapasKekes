<map proto="1.4.0">
<name>Flag Football: Pokemon Stadium</name>
<version>1.1.5</version>
<objective>Capture the flag as many times as possible in eight minutes!</objective>
<gamemode>ffb</gamemode>
<authors>
    <author uuid="bdc16c03-5158-4fee-9e36-ca2c3e6fa5a9"/> <!-- bepiess -->
    <author uuid="76b4cc36-f899-4c42-8ad5-f9ba48ffd4c4"/> <!-- slayersource -->
    <author uuid="556fd070-7c92-4742-a061-c352b30728f8"/> <!-- PhantomOrion -->
</authors>
<contributors>
    <contributor uuid="0c44ca5a-6a42-49b7-81f2-58dc6d2ae3e9" contribution="Feedback, XML, and Minor Assistance"/> <!-- Xerocoles -->
</contributors>
<teams>
    <team id="red-team" color="dark red" max="5">Red</team>
    <team id="blue-team" color="blue" max="5">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <item slot="0" material="stone sword" unbreakable="true"/>
        <item slot="1" material="bow" unbreakable="true"/>
        <item slot="2" material="golden apple"/>
        <item slot="8" material="arrow" amount="12"/>
        <leggings material="chainmail leggings" enchantment="protection projectile:3" unbreakable="true"/>
        <boots material="iron boots" unbreakable="true"/>
        <game-mode>adventure</game-mode>
    </kit>
    <kit id="red-kit" parent="spawn-kit">
        <helmet color="993333" unbreakable="true" material="leather helmet"/>
        <chestplate color="993333" unbreakable="true" material="leather chestplate"/>
    </kit>
    <kit id="blue-kit" parent="spawn-kit">
        <helmet locked="true" color="334CB2" unbreakable="true" material="leather helmet"/>
        <chestplate locked="true" color="334CB2" unbreakable="true" material="leather chestplate"/>
    </kit>
</kits>
<spawns>
    <spawn team="red-team" kit="red-kit" yaw="0" pitch="-20">
        <region>
            <point>-4.5,14,-17.5</point>
        </region>
    </spawn>
    <spawn team="blue-team" kit="blue-kit" yaw="180" pitch="-20">
        <region>
            <point>-4.5,14,26.5</point>
        </region>
    </spawn>
    <default yaw="90">
        <region>
            <cuboid min="-0.2,66,4.8" max="-0.8,66,4.2"/>
        </region>
    </default>
</spawns>
<respawn delay="4s"/>
<flags flag-proximity-metric="none" net-proximity-metric="none" required="false">
    <flag id="flag" name="Flag" color="white" shared="true" pickup-filter="above-or-below">
        <post id="center-post" recover-time="8s" respawn-time="4">
            <block>-4.5,15,4.5</block>
        </post>
        <pickup-kit force="true">
            <potion duration="oo">speed</potion>
        </pickup-kit>
        <drop-kit force="true">
            <potion duration="0">speed</potion>
        </drop-kit>
        <net points="1" region="blue-spawn" capture-filter="only-blue"/>
        <net points="1" region="red-spawn" capture-filter="only-red"/>
    </flag>
</flags>
<score/>
<time result="score" overtime="1m" max-overtime="5m">8m</time>
<filters>
    <team id="only-red">red-team</team>
    <team id="only-blue">blue-team</team>
    <all id="red-team-carrying-flag">
        <team>red-team</team>
        <carrying-flag>flag</carrying-flag>
    </all>
    <all id="blue-team-carrying-flag">
        <team>blue-team</team>
        <carrying-flag>flag</carrying-flag>
    </all>
    <any id="above-or-below">
        <not>
            <cuboid min="-2,15,2" max="-6,13,6"/>
        </not>
    </any>
    <all id="trapdoor-no-open">
        <any>
            <not>
                <material>trap door</material>
            </not>
        </any>
    </all>
</filters>
<regions>
    <union id="spawn-points">
        <point id="red-spawn-point">-4.5,14.25,-17.5</point>
        <point id="blue-spawn-point">-4.5,14.25,26.5</point>
    </union>
    <union id="sides">
        <rectangle id="red-side" min="4,-1" max="42,10"/>
        <rectangle id="blue-side" min="-13,10" max="-51,-1"/>
    </union>
    <union id="nets">
        <union id="red-net">
            <cuboid min="37,14,2" max="42,17,7"/>
        </union>
        <union id="blue-net">
            <cuboid min="-46,14,7" max="-51,17,2"/>
        </union>
    </union>
    <union id="spawns">
        <cuboid id="red-spawn" min="-2,13,-15" max="-6,16,-19"/>
        <cuboid id="blue-spawn" min="-2,13,24" max="-6,16,28"/>
    </union>
    <apply use="trapdoor-no-open" block="never" region="everywhere"/>
    <apply block="never" region="everywhere" message="You may not edit the map!"/>
</regions>
<proximity-alarms>
    <proximity-alarm message="You are running to the wrong goal!" flare-radius="0" region="blue-side" detect="red-team-carrying-flag" notify="red-team-carrying-flag"/>
    <proximity-alarm message="You are running to the wrong goal!" flare-radius="0" region="red-side" detect="blue-team-carrying-flag" notify="blue-team-carrying-flag"/>
</proximity-alarms>
<portals>
    <portal observers="never" filter="red-team-carrying-flag" region="red-net" destination="red-spawn-point" yaw="@0" pitch="@-20"/>
    <portal observers="never" filter="blue-team-carrying-flag" region="blue-net" destination="blue-spawn-point" yaw="@180" pitch="@-20"/>
</portals>
<toolrepair>
    <tool>stone sword</tool>
    <tool>bow</tool>
</toolrepair>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>chainmail leggings</item>
    <item>iron boots</item>
</itemremove>
<kill-rewards>
    <kill-reward>
        <item material="golden apple"/>
        <item material="arrow" amount="3"/>
    </kill-reward>
</kill-rewards>
<disabledamage>
    <damage>fall</damage>
</disabledamage>
<hunger>
    <depletion>off</depletion>
</hunger>
<timelock>on</timelock>
</map>
