<map proto="1.5.0">
<name>Coven</name>
<version>1.6.1</version>
<objective>Reach 750 points before the opposing team!</objective>

<!-- Variants -->
<variant id="boneless">Boneless</variant>
<variant id="rod">Rod</variant>
<variant id="rb">RB</variant>
<variant id="by">BY</variant>
<variant id="gb">GB</variant>
<variant id="yr">YR</variant>

<!-- Constants -->
<constants>
    <constant id="blue_color">blue</constant>
    <constant id="blue_name">Blue</constant>
    <constant id="red_color">dark red</constant>
    <constant id="red_name">Red</constant>
    <constant id="team_size">5</constant>

    <!-- Required by the conquest include. -->
    <constant id="damage-resistance">4s</constant>
    <constant id="respawn-timer">3s</constant>
</constants>
<if variant="by">
    <constants>
        <constant id="red_color">yellow</constant>
        <constant id="red_name">Yellow</constant>
    </constants>
</if>
<if variant="gb">
    <constants>
        <constant id="red_color">green</constant>
        <constant id="red_name">Green</constant>
    </constants>
</if>
<if variant="yr">
    <constants>
        <constant id="blue_color">yellow</constant>
        <constant id="blue_name">Yellow</constant>
    </constants>
</if>

<!-- Includes -->
<unless variant="boneless">
    <!-- Base conquest kit include file -->
    <!-- Created by mameBT -->
    <!-- Version 2026.02.04-1 -->
    <!-- Golden apple kill reward include file -->
    <!-- Author: Pablete1234 -->
    <!-- Version 2026.03.03 -->
    <!--
        This include file prevents golden apple consumption from being interrupted
        after killing another play and receiving a golden apple as a kill reward.
    -->
    <constants fallback="true">
        <constant id="gapple-name" delete="true"/>
        <constant id="gapple-lore" delete="true"/>
        <constant id="gapple-slot" delete="true"/>
        <constant id="gapple-locked" delete="true"/>
        <constant id="gapple-reward-filter" delete="true"/>
    </constants>
    <variables>
        <variable id="missing_gaps" scope="player"/>
    </variables>
    <filters>
        <holding id="holding-gap" ignore-metadata="true">
            <item>golden apple</item>
        </holding>
        <pulse id="pulse-give-gap" duration="0.05s" period="0.1s" filter="all(not(holding-gap),missing_gaps=1..)"/>
    </filters>
    <actions>
        <action id="give-gap" scope="player">
            <kit deduct-items="false">
                <item material="golden apple" slot="${gapple-slot}" locked="${gapple-locked}" name="${gapple-name}" lore="${gapple-lore}"/>
            </kit>
            <set var="missing_gaps" value="missing_gaps-1"/>
        </action>
        <trigger scope="player" filter="pulse-give-gap" action="give-gap"/>
    </actions>
    <kill-rewards>
        <kill-reward filter="${gapple-reward-filter}">
            <action>
                <set var="missing_gaps" value="missing_gaps+1"/>
                <action filter="not(holding-gap)">
                    <action id="give-gap"/>
                </action>
            </action>
        </kill-reward>
    </kill-rewards>
    <constants fallback="true">
        <constant id="override-itemkeep">false</constant>
        <constant id="override-kill-reward">false</constant>
    </constants>
    <kits>
        <kit id="base-kit">
            <clear/>
            <item slot="0" unbreakable="true" material="stone sword"/>
            <item slot="1" unbreakable="true" material="bow"/>
            <item slot="2" material="golden apple"/>
            <item slot="8" amount="12" material="arrow"/>
            <helmet unbreakable="true" team-color="true" material="leather helmet"/>
            <chestplate unbreakable="true" team-color="true" material="leather chestplate"/>
            <leggings unbreakable="true" material="chainmail leggings">
                <enchantment level="3">projectile_protection</enchantment>
            </leggings>
            <boots unbreakable="true" material="iron boots"/>
            <effect duration="${damage-resistance}" amplifier="5">resistance</effect>
            <game-mode>adventure</game-mode>
        </kit>
    </kits>
    <toolrepair>
        <tool>stone sword</tool>
        <tool>bow</tool>
    </toolrepair>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>iron boots</item>
        <item>banner</item>
    </itemremove>
    <unless constant="override-itemkeep" constant-value="true">
        <itemkeep>
            <item>stone sword</item>
            <item>bow</item>
            <item>golden apple</item>
            <item>arrow</item>
        </itemkeep>
    </unless>
    <unless constant="override-kill-reward" constant-value="true">
        <kill-rewards>
            <kill-reward>
                <item amount="6" material="arrow"/>
            </kill-reward>
        </kill-rewards>
    </unless>
    <respawn delay="${respawn-timer}" auto="true"/>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</unless>

<authors>
    <author uuid="2df2bef6-6f50-4e4e-a891-048990bf1f5c"/> <!-- Blaszszcak -->
</authors>
<contributors>
    <contributor uuid="d9f76ee6-975a-45ab-bbda-763600738a73"/> <!-- Aleeeay -->
    <contributor uuid="74948888-fdb8-4446-9340-f7688c2435cc"/> <!-- Zero_Frosty -->
    <contributor uuid="0a359aef-794b-4d88-97ca-5672d9421532" contribution="Decoration"/> <!-- xTrina -->
    <contributor uuid="0c44ca5a-6a42-49b7-81f2-58dc6d2ae3e9"/> <!-- Xerocoles -->
</contributors>

<teams>
    <team id="blue" color="${blue_color}" max="${team_size}" max-overfill="${team_size}">${blue_name}</team>
    <team id="red" color="${red_color}" max="${team_size}" max-overfill="${team_size}">${red_name}</team>
</teams>

<!-- Kit: Standard (conquest + spawn resistance) -->
<unless variant="boneless,rod">
    <kits>
        <kit id="spawn-kit" parent="base-kit">
            <effect duration="4s" amplifier="255">resistance</effect>
        </kit>
    </kits>
</unless>

<!-- Kit: Rod variant (conquest + fishing rod) -->
<if variant="rod">
    <kits>
        <kit id="spawn-kit" parent="base-kit">
            <effect duration="4s" amplifier="255">resistance</effect>
            <item slot="3" unbreakable="true" material="fishing rod"/>
        </kit>
    </kits>
    <toolrepair>
        <tool>fishing rod</tool>
    </toolrepair>
</if>

<!-- Kit: Boneless variant (sword only, no bow/arrows) -->
<if variant="boneless">
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" unbreakable="true" material="stone sword"/>
            <item slot="1" material="golden apple"/>
            <helmet locked="true" unbreakable="true" team-color="true" material="leather helmet"/>
            <chestplate locked="true" unbreakable="true" team-color="true" material="leather chestplate"/>
            <leggings locked="true" unbreakable="true" material="chainmail leggings"/>
            <boots locked="true" unbreakable="true" material="iron boots">
                <enchantment>feather_falling</enchantment>
                <enchantment>fire_protection</enchantment>
            </boots>
            <effect duration="1s" amplifier="0">health boost</effect>
            <effect duration="1s" amplifier="10">regeneration</effect>
            <effect duration="4s" amplifier="255">resistance</effect>
            <game-mode>adventure</game-mode>
        </kit>
    </kits>
    <toolrepair>
        <tool>stone sword</tool>
    </toolrepair>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>iron boots</item>
    </itemremove>
    <itemkeep>
        <item>golden apple</item>
    </itemkeep>
    <kill-reward>
        <item material="golden apple"/>
    </kill-reward>
    <respawn delay="3s" auto="true"/>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</if>

<!-- Spawns -->
<spawns>
    <default>
        <region yaw="-45">
            <point>-23.5,70,-24.5</point>
        </region>
    </default>
    <spawn team="blue" kit="spawn-kit">
        <region yaw="0">
            <point>28.5,5,-26.6</point>
        </region>
    </spawn>
    <spawn team="red" kit="spawn-kit">
        <region yaw="-90">
            <point>-25.5,5,27.5</point>
        </region>
    </spawn>
</spawns>

<!-- Regions (rounded union capture areas) -->
<regions>
    <union id="cap-region-bot">
        <cuboid min="-6,6,-1" max="-1,10,-8"/>
        <cuboid min="-7,6,-2" max="0,10,-7"/>
    </union>
    <union id="cap-region-cave">
        <cuboid min="22,4,22" max="29,8,27"/>
        <cuboid min="23,4,21" max="28,8,28"/>
    </union>
    <union id="cap-region-top">
        <cuboid min="17,12,17" max="24,16,22"/>
        <cuboid min="18,12,16" max="23,16,23"/>
    </union>
    <apply block="never"/>
</regions>

<king>
    <hills required="false" capture-time="5s" points="1" time-multiplier="0" show-progress="true" neutral-state="true" incremental="true" permanent="false">
        <hill name="Top" capture="cap-region-top" progress="cap-region-top"/>
        <hill name="Bottom" capture="cap-region-bot" progress="cap-region-bot"/>
        <hill name="Cave" capture="cap-region-cave" progress="cap-region-cave"/>
    </hills>
</king>

<score>
    <limit>750</limit>
</score>
</map>
