<map proto="1.4.2">
<name>Inferno 5v5</name>
<version>1.1.2</version>
<objective>Capture the enemy wool!</objective>
<time result="objectives" max-overtime="10m" overtime="10m">25m</time>
<authors>
    <author uuid="425ea9a7-82a8-40f6-a1dc-1e4d91546fae"/>
</authors>
<teams>
    <team id="blue-team" color="blue" max="5" max-overfill="5">Blue</team>
    <team id="red-team" color="dark red" max="5" max-overfill="5">Red</team>
</teams>
<kits>
    <kit id="default-kit">
        <effect>night vision</effect>
    </kit>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" show-unbreakable="false" material="iron sword"/>
        <item slot="1" unbreakable="true" enchantment="arrow infinite" material="bow"/>
        <item slot="28" amount="1" material="arrow"/>
        <item slot="2" unbreakable="true" show-unbreakable="false" material="iron pickaxe">
            <enchantment>efficiency</enchantment>
        </item>
        <item slot="3" unbreakable="true" show-unbreakable="false" material="iron axe"/>
        <item slot="4" amount="16" material="glass"/>
        <item slot="5" amount="64" damage="1" material="wood"/>
        <item slot="6" amount="64" damage="1" material="wood"/>
        <item slot="7" material="golden apple"/>
        <helmet unbreakable="true" team-color="true" material="leather helmet"/>
        <chestplate unbreakable="true" team-color="true" material="leather chestplate"/>
        <effect duration="5" amplifier="3">heal</effect>
        <effect duration="5" amplifier="3">damage resistance</effect>
    </kit>
</kits>
<spawns>
    <default kit="default-kit">
        <region yaw="-90">
            <point>0,88,0</point>
        </region>
    </default>
    <spawn team="blue-team" kit="spawn-kit">
        <region yaw="180">
            <point>0.5,9,94</point>
        </region>
    </spawn>
    <spawn team="red-team" kit="spawn-kit">
        <region yaw="0">
            <point>0.5,9,-94</point>
        </region>
    </spawn>
</spawns>
<filters>
    <not id="blue-in-wr">
        <any>
            <team id="only-red">red-team</team>
            <material>chest</material>
        </any>
    </not>
    <not id="red-in-wr">
        <any>
            <team id="only-blue">blue-team</team>
            <material>chest</material>
        </any>
    </not>
    <material id="only-iron">iron block</material>
    <material id="only-gravel">gravel</material>
    <not id="deny-void">
        <void/>
    </not>
</filters>
<regions>
    <union id="spawner-regions">
            <point id="spawner-spawn">24.5,9,0.5</point>
            <cylinder id="spawner-player" base="24.5,9,0.5" radius="2.5" height="5"/>
            <cuboid id="spawner-region" min="24,9,0" max="25,9,1"/>
        </union>
    <complement id="buildable">
        <rectangle min="-34,-62" max="28,63"/>
        <union id="gravel">
            <rectangle min="-40,-5" max="-32,6"/>
        </union>
        <union id="not-buildable">
            <rectangle min="-2,-55" max="3,-51"/>
            <rectangle min="-2,-73" max="3,-60"/>
            <rectangle min="-2,52" max="3,56"/>
            <rectangle min="-2,61" max="3,74"/>
            <rectangle min="-15,-6" max="3,7"/>
        </union>
    </complement>
    <union id="bridges">
            <rectangle min="-2,56" max="3,61"/>
            <rectangle min="-2,-60" max="3,-55"/>
        </union>
    <intersect id="under-bridges">
        <region id="bridges"/>
        <below y="8"/>
    </intersect>
     <union id="spawns">
        <union id="blue-spawn">
            <rectangle min="-11,81" max="12,110"/>
        </union>
        <union id="red-spawn">
            <rectangle min="-11,-109" max="12,-80"/>
        </union>
    </union>
    <union id="gaps">
        <rectangle id="gaps-for-blue" min="38,-63" max="54,-50"/>
        <rectangle id="gaps-for-red" min="41,51" max="54,64"/>
    </union>
    <union id="wool-rooms">
        <rectangle id="cyan-for-red" min="-48,91" max="-35,104"/> <!-- Blue must get -->
        <rectangle id="pink-for-blue" min="-48,-103" max="-35,-90"/> <!-- Red must get -->
    </union>
    <apply enter="only-blue" region="blue-spawn" message="¡No puedes entrar en el spawn del enemigo!"/>
    <apply enter="only-red" region="red-spawn" message="¡No puedes entrar en el spawn del enemigo!"/>
    <apply enter="only-blue" region="gaps-for-blue" message="¡No puedes entrar aquí!"/>
    <apply enter="only-red" region="gaps-for-red" message="¡No puedes entrar entrar aquí!"/>
    <apply block="blue-in-wr" use="only-blue" region="gaps-for-blue"/>
    <apply block="red-in-wr" use="only-red" region="gaps-for-red"/>
    <apply enter="only-blue" region="pink-for-blue" message="¡No puedes entrar en la sala de lana de tu propio equipo!"/>
    <apply enter="only-red" region="cyan-for-red" message="¡No puedes entrar en la sala de lana de tu propio equipo!"/>
    <apply block="only-iron" region="spawns" message="¡Solo puedes romper bloques de hierro en el spawn!"/>
    <apply block="blue-in-wr" use="only-blue" region="pink-for-blue"/>
    <apply block="red-in-wr" use="only-red" region="cyan-for-red"/>
    <apply block="never" region="under-bridges" message="¡No puedes construir en el vacío!"/>
    <apply block="always" region="buildable"/>
    <apply block-place="never" region="not-buildable" message="¡No puedes construir en el vacío!"/>
    <apply block-place="deny-void" message="¡No puedes construir en el vacío!"/>
    <apply block-break="only-gravel" region="gravel"/>
    <apply block="never" region="spawner-region" message="You may not destroy the spawners!"/>
</regions>
<spawners>
    <spawner spawn-region="spawner-spawn" player-region="spawner-player" max-entities="1" delay="12s">
        <item material="golden apple"/>
    </spawner>
</spawners>
<renewables>
    <renewable rate="1" grow="false" particles="true" sound="true" avoid-entities="true" region="spawns" renew-filter="only-iron"/>
</renewables>
<wools wool-proximity-metric="none" monument-proximity-metric="closest block">
    <wool team="blue-team" color="cyan" location="-44,8.5,-98.5">
        <monument>
            <block>0,9,82</block>
        </monument>
    </wool>
    <wool team="red-team" color="pink" location="-44,8.5,99.5">
        <monument>
            <block>0,9,-82</block>
        </monument>
    </wool>
</wools>
<toolrepair>
    <tool>iron sword</tool>
    <tool>bow</tool>
    <tool>iron pickaxe</tool>
    <tool>iron axe</tool>
</toolrepair>
<itemremove>
    <item>sandstone</item>
    <item>wood</item>
    <item>golden carrot</item>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>IRON_PLATE</item>
</itemremove>
<itemkeep>
    <item>arrow</item>
</itemkeep>
<kill-reward>
    <item material="golden apple"/>
    <item amount="32" damage="1" material="wood"/>
    <item amount="32" damage="2" material="glass"/>
</kill-reward>
<maxbuildheight>21</maxbuildheight>
<respawn delay="4s" auto="true" blackout="true"/>
<hunger>
        <depletion>off</depletion>
</hunger>
<crafting>
    <disable>iron trapdoor</disable>
    <disable>minecart</disable>
    <disable>boat</disable>
</crafting>
</map>
