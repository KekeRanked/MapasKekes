<?xml version="1.0"?>
<map proto="1.3.0">
<name>Empire 5v5</name>
<version>2.3.3</version>
<objective>Capture both wool and return them safely to your victory monument.</objective>
<time result="objectives" max-overtime="10m" overtime="10m">30m</time>
<authors>
    <author uuid="c65e66b3-e932-4b33-b907-fe4916806076"/> <!-- Draco_Rogue -->
</authors>
<teams>
    <team color="dark red" max="5">Red</team>
    <team color="blue" max="5">Blue</team>
</teams>
<kits>
    <kit name="spawn">
        <item slot="0">stone sword</item>
        <item slot="1" enchantment="arrow infinite:1">bow</item>
        <item slot="2" enchantment="durability:3">iron pickaxe</item>
        <item slot="3" enchantment="dig speed:1;durability:3">iron axe</item>
        <item slot="4" amount="1">golden apple</item>
        <item slot="5" amount="64">cooked beef</item>
        <item slot="6" amount="64">glass</item>
        <item slot="7" amount="64">wood</item>
        <item slot="28" amount="1">arrow</item>
        <potion duration="5" amplifier="4">damage resistance</potion>
    </kit>
    <kit name="red" parents="spawn">
        <helmet color="993333">leather helmet</helmet>
        <chestplate color="993333" enchantment="protection projectile:1">leather chestplate</chestplate>
        <leggings color="993333">leather leggings</leggings>
        <boots color="993333">leather boots</boots>
    </kit>
    <kit name="blue" parents="spawn">
        <helmet color="334CB2">leather helmet</helmet>
        <chestplate color="334CB2" enchantment="protection projectile:1">leather chestplate</chestplate>
        <leggings color="334CB2">leather leggings</leggings>
        <boots color="334CB2">leather boots</boots>
    </kit>
</kits>
<spawns team="blue" kit="blue">
    <spawn yaw="0">
        <point>-1.5,6,-60.5</point>
    </spawn>
</spawns>
<spawns team="red" kit="red">
    <spawn yaw="180">
        <point>-1.5,6,85.5</point>
    </spawn>
</spawns>
<spawns>
    <default yaw="-90">
        <cylinder base="-70.5,11,12.5" radius="2.5" height="0"/>
    </default>
</spawns>
<wools>
    <wools team="red">
        <wool color="orange">
            <block>-0.5,7,93.5</block>
        </wool>
        <wool color="yellow">
            <block>-2.5,7,93.5</block>
        </wool>
    </wools>
    <wools team="blue">
        <wool color="purple">
            <block>-0.5,7,-68.5</block>
        </wool>
        <wool color="lime">
            <block>-2.5,7,-68.5</block>
        </wool>
    </wools>
</wools>
<filters>
    <filter name="only-iron">
        <material>iron block</material>
    </filter>
    <filter name="only-red">
        <team>red</team>
    </filter>
    <filter name="only-blue">
        <team>blue</team>
    </filter>
    <filter name="deny-spawner">
        <deny>
            <block>mob spawner</block>
        </deny>
    </filter>
    <filter name="anti-grief-blue" parents="only-blue">
        <deny>
            <block>mob spawner</block>
            <block>chest</block>
        </deny>
    </filter>
    <filter name="anti-grief-red" parents="only-red">
        <deny>
            <block>mob spawner</block>
            <block>chest</block>
        </deny>
    </filter>
    <filter name="deny-void">
        <deny>
            <void/>
        </deny>
    </filter>


    <filter name="deny-wool">
        <deny>
            <block>wool</block>
        </deny>
    </filter>
    
    <filter name="only-red-usage">
        <not>
            <all>
                <any>
                    <block>chest</block>
                    <block>workbench</block>
                </any>
                <team>blue</team>
            </all>
        </not>
    </filter>
    <filter name="only-blue-usage">
        <not>
            <all>
                <any>
                    <block>chest</block>
                    <block>workbench</block>
                </any>
                <team>red</team>
            </all>
        </not>
    </filter>
</filters>
<regions>
    <apply block="deny-spawner">
        <rectangle min="-oo,-oo" max="oo,oo"/>
    </apply>
    <!--   Blue has to capture these   -->
    <union name="blue-wool-rooms">
        <rectangle name="lime-room" min="-22,103" max="-37,88"/>
        <rectangle name="purple-room" min="34,88" max="19,103"/>
    </union>
    <!--   Red has to capture these   -->
    <union name="red-wool-rooms">
        <rectangle name="orange-room" min="19,-63" max="34,-78"/>
        <rectangle name="yellow-room" min="-22,-63" max="-37,-78"/>
    </union>
    <apply enter="only-blue" block="only-blue" use="only-blue-usage" message="You may not access/modify your own wool room!">
        <region name="blue-wool-rooms"/>
    </apply>
    <apply enter="only-red" block="only-red" use="only-red-usage" message="You may not access/modify your own wool room!">
        <region name="red-wool-rooms"/>
    </apply>
    <apply block-break="anti-grief-blue">
        <region name="blue-wool-rooms"/>
    </apply>
    <apply block-break="anti-grief-red">
        <region name="red-wool-rooms"/>
    </apply>
    <apply block="deny-void" message="You may not edit in the void area!">
        <negative>
            <rectangle min="-39,63" max="36,-38"/>
        </negative>
    </apply>

    <apply block-place="deny-wool" message="No puedes colocar lana!">
        <rectangle min="-oo,-oo" max="oo,oo"/>
    </apply>

    <apply block="only-iron" enter="only-blue" use="only-blue">
        <circle name="blue-spawn" center="-1.5,-60.5" radius="12"/>
        <rectangle name="blue-bridge" min="-4,-44" max="1,-51"/>
    </apply>
    <apply block="only-iron" enter="only-red" use="only-red">
        <circle name="red-spawn" center="-1.5,85.5" radius="12"/>
        <rectangle name="red-bridge" min="1,69" max="-4,76"/>
    </apply>
    <apply block="deny-all">
        <cuboid name="above-25" min="-oo,25,-oo" max="oo,oo,oo"/>
    </apply>
</regions>
<renewables>
    <renewable rate="1" grow="false" particles="true" sound="true" avoid-entities="true" region="red-spawn" renew-filter="only-iron"/>
    <renewable rate="1" grow="false" particles="true" sound="true" avoid-entities="true" region="blue-spawn" renew-filter="only-iron"/>
</renewables>
<toolrepair>
    <tool>stone sword</tool>
    <tool>bow</tool>
    <tool>iron axe</tool>
    <tool>iron pickaxe</tool>
    <tool>arrow</tool>
</toolrepair>
<itemremove>
    <item>apple</item>
    <item>cooked beef</item>
    <item>string</item>
    <item>glowstone dust</item>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>leather boots</item>
    <item>leather leggings</item>
    <item>redstone</item>
    <item>wool</item>
</itemremove>
<killreward>
    <item amount="1">golden apple</item>
</killreward>
</map>
